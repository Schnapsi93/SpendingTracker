<?xml version="1.0" encoding="utf-8"?>
<!-- App icon foreground: a pie chart with one slice pulled out.
     Everything stays inside the central "safe zone", so no phone's
     icon shape ever cuts it off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Three quarters of the pie, in white. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,54 L78,54 A24,24 0 1,1 54,30 Z" />

    <!-- The top-right quarter in amber, moved a little outwards. -->
    <path
        android:fillColor="#FFFFC107"
        android:pathData="M57,51 L57,27 A24,24 0 0,1 81,51 Z" />
</vector>